# ================================================================
# VELAS ESTOQUE IA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais
# NUNCA envie o arquivo .env para o GitHub!
# ================================================================

# Chave da API da Anthropic (Claude AI)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# Configurações do Banco de Dados
DATABASE_URL=sqlite:///./data/estoque_velas.db

# Configurações da Aplicação
APP_NAME=Velas Estoque IA
APP_VERSION=1.0.0
DEBUG=True

# Configurações do Modelo ML
MODELO_PATH=./ml/modelo_salvo/
DIAS_PREVISAO=30
ESTOQUE_MINIMO_ALERTA=20